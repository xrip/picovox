.define INIT 11             ; Set to proper INIT

.program cms

; CMSLPT - Sound part (no reset/ready signal)
; INPUTS: STROBE, D0-D7
; OUTPUTS: none
; JMP: chip select (AUTOFEED for first chip, SELIN for second - set from C)

.wrap_target
start:
    wait 0 gpio INIT            ; Wait for WE edge (INIT)
    jmp PIN write
    jmp start                   ; If chip not selected (JMP pin low), go back to detection
write:
    in pins, 9                  ; Read data (STROBE, D0-D7)
    push block                  ; Send data
    wait 1 gpio INIT
.wrap
